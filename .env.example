# STF — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# ─── Authentication (Clerk) ──────────────────────────────────────────────────
# Get these from https://clerk.com → your application → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated origins allowed to mint session tokens (the token azp claim).
# Required in production: token verification fails closed without it.
# Local: http://localhost:5173
CLERK_AUTHORIZED_PARTIES=

# ─── Database ────────────────────────────────────────────────────────────────
# Local: postgres://postgres:postgres@localhost:5432/stf
# Production (Vercel): the POOLED Neon URL (host contains -pooler) with ?sslmode=require.
# The client uses TLS, one connection per instance and no prepared statements.
# Migrations use the direct (unpooled) Neon URL instead, not this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stf

# ─── Object Storage (S3-compatible) ──────────────────────────────────────────
# Local: uses MinIO (started by docker compose up)
# Production: AWS S3, Cloudflare R2, Backblaze B2, etc.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=stf-receipts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ─── Anthropic (Claude Haiku — receipt scanning) ─────────────────────────────
# Get your key from https://console.anthropic.com
# Used ONLY for receipt OCR. Your key stays on your server; never sent to us.
ANTHROPIC_API_KEY=sk-ant-...

# ─── HMRC Making Tax Digital ─────────────────────────────────────────────────
# Register your application at https://developer.service.hmrc.gov.uk
# Use the SANDBOX credentials while testing. NEVER use production credentials
# in a .env.local file — add them in your deployment platform only.
HMRC_CLIENT_ID=your-hmrc-client-id
HMRC_CLIENT_SECRET=your-hmrc-client-secret

# HMRC_SANDBOX_MODE controls which HMRC environment the app calls.
# TRUE (default): uses https://test-api.service.hmrc.gov.uk — safe for all testing.
# FALSE: uses https://api.service.hmrc.gov.uk — LIVE submissions. Requires:
#   1. HMRC_SANDBOX_MODE=false in your production deployment environment.
#   2. User opt-in: Settings → HMRC → "Allow live filing with HMRC" and type FILE LIVE (users.hmrc_sandbox_mode = false).
# Both switches must match; if only one is set, filing is refused. Never set FALSE locally.
HMRC_SANDBOX_MODE=true

# Redirect URI registered in your HMRC developer application.
# For local dev: http://localhost:5173/api/hmrc/callback
HMRC_REDIRECT_URI=http://localhost:5173/api/hmrc/callback

# Base64 of 32 random bytes (AES-256-GCM key for stored HMRC tokens).
# Generate with: openssl rand -base64 32
HMRC_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Secret that signs the OAuth state value. Generate with: openssl rand -base64 32
HMRC_STATE_SECRET=replace-with-random-secret

# ─── Application ─────────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:5173
APP_VERSION=0.1.0

# ─── Control plane (Fastify scheduled jobs) ──────────────────────────────────
# Hosts scheduled jobs only; it serves no user-facing routes.
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_HOST=127.0.0.1

# ─── Optional: Open Banking (Phase 3) ────────────────────────────────────────
# TrueLayer or GoCardless — only needed for bank feed integration.
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_REDIRECT_URI=http://localhost:5173/settings/bank/callback

# Optional: egress IP of this server, sent as the Gov-Vendor-Public-IP fraud prevention header.
# HMRC_VENDOR_PUBLIC_IP=
# Sandbox integration suite only (src/lib/hmrc/sandbox.integration.test.ts); skipped when unset.
# HMRC_SANDBOX_REFRESH_TOKEN=
# HMRC_SANDBOX_VRN=
