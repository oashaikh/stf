{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "github": {
    "enabled": false
  },
  "regions": ["lhr1"],
  "functions": {
    "api/cron/refresh-hmrc-tokens.ts": { "maxDuration": 60 },
    "api/cron/create-recurring-entries.ts": { "maxDuration": 60 },
    "api/cron/prepare-vat-draft.ts": { "maxDuration": 60 },
    "api/invoice-pdf.ts": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/cron/refresh-hmrc-tokens", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/create-recurring-entries", "schedule": "0 5 * * *" },
    { "path": "/api/cron/prepare-vat-draft", "schedule": "0 8 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
